# Local preview defaults. Use server-only Railway variables for production secrets.
HOST=127.0.0.1
PORT=3000
# PUBLIC_ORIGIN=https://altstack.io
# DATA_DIR=/data
# PDS_URL=https://altstack.social
# PDS_HANDLE_DOMAIN=altstack.social
# PDS_ADMIN_PASSWORD=
# ALLOW_LEGACY_ACCOUNTS=true
# SESSION_ENCRYPTION_KEY= # 64 hexadecimal characters; preserve privately
# ADMIN_HANDLES=ant
# VERIFIED_ACCOUNT_IDS= # exact IDs for platform-issued verification
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=price_1UPUnxS4YS5sYmND0ZhFHvv9
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_1UPUo4S4YS5sYmND4KPxrjSE
# STRIPE_LIVEMODE=true
# BILLING_VERIFY_ON_START=true
# BACKUPS_ENABLED=true
# BACKUP_ENCRYPTION_KEY= # 64 hexadecimal characters; preserve privately
# BACKUP_S3_BUCKET=
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_REGION=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_PATH_STYLE=false

# Cloudflare Turnstile: restrict the widget hostname to your public site.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# HUMAN_CAPTCHA_REQUIRED=true

# Optional complimentary lifetime Plus grants: comma-separated immutable actor IDs, never handles.
PERMANENT_PLUS_ACCOUNT_IDS=
# Optional administrator-issued exceptions keyed by immutable IDs, e.g.
# ACCOUNT_DESIGNATIONS={"did:plc:example":{"country":"CA","permanentPlus":true}}
ACCOUNT_DESIGNATIONS={}

# Apple iPhone subscriptions (disabled until App Store Connect setup)
# APPLE_IAP_ENABLED=false
# APPLE_BUNDLE_ID=social.amerika.ios
# APPLE_PLUS_PRODUCT_ID=social.amerika.plus.monthly
# APPLE_IAP_ENVIRONMENT=Production
# APPLE_APP_ID=
# APPLE_IAP_KEY_ID=
# APPLE_IAP_ISSUER_ID=
# APPLE_IAP_PRIVATE_KEY=
# Native iPhone push (optional; activate after EAS/Apple push credentials are ready)
# PUSH_NOTIFICATIONS_ENABLED=false
# EXPO_PUSH_ACCESS_TOKEN=

# Android Google Play Billing: disabled until the Play product and API credentials exist.
GOOGLE_PLAY_ENABLED=false
GOOGLE_PACKAGE_NAME=social.amerika.android
GOOGLE_PLUS_PRODUCT_ID=amerika_plus
GOOGLE_PLUS_BASE_PLAN_ID=monthly
# Add the service-account JSON directly to the server secret store, never source.
GOOGLE_PLAY_SERVICE_ACCOUNT=
GOOGLE_RTDN_AUDIENCE=https://altstack.io/api/google/notifications
GOOGLE_RTDN_EMAIL=
# Optional exact account IDs allowed license-tester entitlements; leave empty in production.
GOOGLE_PLAY_TEST_ACCOUNT_IDS=

# Gaming uses DATA_DIR/gaming on the persistent volume. Allow space for game ZIP extraction.
# Optional LOCAL DEVELOPMENT ONLY: folder with checksum-matching original web ZIP packages.
# GAMING_LOCAL_PACKAGES=C:/path/to/gaming-work
