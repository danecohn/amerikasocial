[Desktop Entry]
Type=Application
Name=Amerika Files
GenericName=File Manager
Comment=Browse your files (Amerika-branded launcher for COSMIC Files)
Exec=cosmic-files %U
Icon=system-file-manager
Terminal=false
Categories=System;FileTools;FileManager;
MimeType=inode/directory;
StartupWMClass=com.system76.CosmicFiles
Keywords=files;folders;browse;
