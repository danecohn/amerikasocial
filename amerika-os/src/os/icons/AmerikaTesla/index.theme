[Icon Theme]
Name=Amerika Tesla
Comment=Amerika OS matte app icons
Inherits=AmerikaOS,Adwaita,hicolor
Directories=scalable/apps,512x512/apps,256x256/apps,128x128/apps,64x64/apps,48x48/apps

[scalable/apps]
Size=256
MinSize=16
MaxSize=512
Type=Scalable
Context=Applications

[512x512/apps]
Size=512
Type=Fixed
Context=Applications

[256x256/apps]
Size=256
Type=Fixed
Context=Applications

[128x128/apps]
Size=128
Type=Fixed
Context=Applications

[64x64/apps]
Size=64
Type=Fixed
Context=Applications

[48x48/apps]
Size=48
Type=Fixed
Context=Applications
