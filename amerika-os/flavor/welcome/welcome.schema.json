{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AltStack Desktop welcome spec",
  "type": "object",
  "required": ["schema", "id", "version", "title", "steps"],
  "properties": {
    "schema": {"const": 1},
    "id": {"type": "string"},
    "version": {"type": "string"},
    "title": {"type": "string"},
    "tagline": {"type": "string"},
    "show_once_key": {"type": "string"},
    "autostart": {"type": "object"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "steps": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "body", "actions"],
        "properties": {
          "id": {"type": "string"}, "title": {"type": "string"}, "body": {"type": "string"},
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "label", "type"],
              "properties": {
                "id": {"type": "string"}, "label": {"type": "string"},
                "type": {"enum": ["next", "finish", "command", "settings-page", "app", "link"]},
                "argv": {"type": "array", "items": {"type": "string"}, "minItems": 1},
                "privileged": {"type": "boolean"}, "confirm": {"type": "string"}, "optional": {"type": "boolean"},
                "page": {"type": "string"}, "desktop_id": {"type": "string"}, "url": {"type": "string", "pattern": "^https://"}
              }
            }
          }
        }
      }
    }
  }
}
