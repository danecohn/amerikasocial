# Without PDS_URL, Amerika Social runs an isolated local preview, not AT Protocol.
HOST=127.0.0.1
PORT=3000
# When deployed behind HTTPS, set your exact site origin (no path).
# PUBLIC_ORIGIN=https://your-site.up.railway.app
# Set this to YOUR independently operated PDS; never use bsky.social here.
# PDS_URL=https://pds.your-domain.example
# Use a separate data directory when switching to real AT Protocol.
# DATA_DIR=./data/network
# Stripe: server-only restricted API key. Never commit actual keys or webhook secrets.
# STRIPE_SECRET_KEY=rk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
