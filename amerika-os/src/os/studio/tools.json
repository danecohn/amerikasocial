{
  "version": 1,
  "conventions": {
    "mcp_name": "<app>_<tool with dots replaced by underscores>, e.g. render_scene_run_python",
    "rpc_method": "<app>.<tool name>, e.g. render.scene.run_python",
    "transport": "JSON-RPC 2.0 over HTTP POST to <descriptor.url>/rpc, header 'Authorization: Bearer <descriptor.token>'; params is the tool arguments object",
    "descriptor": "$XDG_RUNTIME_DIR/amerika/studio-<app>.json = {app,url,token,pid,version}, mode 0600, removed on exit",
    "required_extra_methods": [
      "app.ping -> {ok:true,app,version,ready:bool}"
    ],
    "result": "JSON object. Images are returned as {images:[{mime,base64}]} next to other fields; the MCP server turns them into image content blocks.",
    "errors": "JSON-RPC error {code,message,data?}. -32601 unknown method, -32602 invalid params, -32001 user denied/cancelled, -32002 app busy, -32003 path outside project, -32004 not ready, -32000 other",
    "risk": "read = no state change; act = changes project/app state; critical = executes model- or caller-supplied code, always requires approval in Amerika Agent"
  },
  "apps": {
    "render": {
      "title": "Amerika Render",
      "launcher": "amerika-render",
      "tools": [
        {
          "name": "scene.info",
          "description": "Summarise the current Blender scene: objects (name, type, location, dimensions, materials), collections, selection, units, frame range, file path.",
          "risk": "read",
          "timeout": 60,
          "inputSchema": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          }
        },
        {
          "name": "scene.run_python",
          "description": "Run Python (bpy) inside Blender on the main thread. Shows the code in the panel; if 'Review before run' is on, waits for the user to approve. Returns stdout, stderr and the new undo checkpoint id.",
          "risk": "critical",
          "timeout": 120,
          "inputSchema": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Python source to execute",
                "maxLength": 100000
              },
              "description": {
                "type": "string",
                "description": "One-line human description shown in the approval dialog"
              }
            },
            "additionalProperties": false,
            "required": [
              "code"
            ]
          }
        },
        {
          "name": "model.create_from_description",
          "description": "Ask Claude (through Amerika Render's own assistant) to model an object or scene from a text description and build it in Blender. Returns the assistant's explanation and the created object names.",
          "risk": "act",
          "timeout": 600,
          "inputSchema": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "description": "What to model, in plain words"
              },
              "style": {
                "type": "string",
                "description": "Optional style hint, e.g. low-poly, realistic, voxel"
              },
              "name": {
                "type": "string",
                "description": "Optional base name for created objects"
              }
            },
            "additionalProperties": false,
            "required": [
              "description"
            ]
          }
        },
        {
          "name": "model.apply_change",
          "description": "Ask the assistant to change existing geometry/materials/lights according to an instruction.",
          "risk": "act",
          "timeout": 600,
          "inputSchema": {
            "type": "object",
            "properties": {
              "instruction": {
                "type": "string",
                "description": "The change to make"
              },
              "target": {
                "type": "string",
                "description": "Optional object name or 'selection'"
              }
            },
            "additionalProperties": false,
            "required": [
              "instruction"
            ]
          }
        },
        {
          "name": "viewport.screenshot",
          "description": "Render the 3D viewport to a PNG and return it as an image.",
          "risk": "read",
          "timeout": 60,
          "inputSchema": {
            "type": "object",
            "properties": {
              "width": {
                "type": "integer",
                "description": "Pixels",
                "minimum": 64,
                "maximum": 2048
              },
              "height": {
                "type": "integer",
                "description": "Pixels",
                "minimum": 64,
                "maximum": 2048
              },
              "view": {
                "type": "string",
                "description": "Camera angle",
                "enum": [
                  "current",
                  "front",
                  "right",
                  "top",
                  "perspective",
                  "camera"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        {
          "name": "export",
          "description": "Export the scene or selection into the project folder.",
          "risk": "act",
          "timeout": 300,
          "inputSchema": {
            "type": "object",
            "properties": {
              "format": {
                "type": "string",
                "description": "File format",
                "enum": [
                  "glb",
                  "gltf",
                  "fbx",
                  "obj",
                  "stl",
                  "blend",
                  "png"
                ]
              },
              "path": {
                "type": "string",
                "description": "Path relative to the project directory (never absolute, never containing ..)"
              },
              "selection_only": {
                "type": "boolean",
                "description": "Export only selected objects"
              }
            },
            "additionalProperties": false,
            "required": [
              "format",
              "path"
            ]
          }
        },
        {
          "name": "app.prompt",
          "description": "Send a natural-language instruction to this app's built-in Claude assistant (the same chat panel the user sees) and return its final reply plus a summary of the tool calls it made.",
          "risk": "act",
          "timeout": 600,
          "inputSchema": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string",
                "description": "Instruction for the assistant"
              },
              "timeout_s": {
                "type": "integer",
                "description": "Max seconds to wait",
                "minimum": 5,
                "maximum": 900
              }
            },
            "additionalProperties": false,
            "required": [
              "message"
            ]
          }
        }
      ]
    },
