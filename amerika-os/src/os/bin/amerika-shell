#!/bin/sh
# Starts the Amerika Shell. gtk4-layer-shell must be loaded before libwayland-client, hence LD_PRELOAD for Python.
lib="${AMERIKA_LAYERSHELL_LIB:-}"
if [ -z "$lib" ]; then
  for c in /usr/lib/*/libgtk4-layer-shell.so.0; do [ -e "$c" ] && lib="$c" && break; done
fi
[ -n "$lib" ] && export LD_PRELOAD="$lib${LD_PRELOAD:+:$LD_PRELOAD}"
host="${AMERIKA_SHELL_HOST:-/usr/libexec/amerika/amerika-shell-host}"
if [ -x "$host" ]; then exec "$host" "$@"; fi
# Source development can still start without a compiled host; capture is then unavailable.
exec python3 -m amerika.shell.main "$@"
