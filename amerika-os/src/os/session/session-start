#!/bin/sh
# Runs inside the compositor once it is up (WAYLAND_DISPLAY and DISPLAY are set by KWin).
# The session ends when this script exits.
dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE \
  XDG_SESSION_DESKTOP QT_QPA_PLATFORM GDK_BACKEND MOZ_ENABLE_WAYLAND AMERIKA_SESSION 2>/dev/null

# AMERIKA_BIN is only for testing a build tree; installed systems use /usr/bin
# one-time look and feel (window buttons, effects, colours); safe to re-run
"${AMERIKA_BIN:-/usr/bin}/amerika-first-run"

# the startup screen covers the gap until the shell has put its bar and dock on screen
rm -f "${XDG_RUNTIME_DIR:-/tmp}/amerika/shell-ready"
"${AMERIKA_BIN:-/usr/bin}/amerika-splash" >/dev/null 2>&1 &

# clean up the Super-key binding that Amerika OS 3.0.0 to 3.0.2 wrote into kwinrc (the Windows key is now a KWin script shortcut)
"${AMERIKA_LIBEXEC:-/usr/libexec/amerika}/amerika-restore-meta"

shell_pid=""
cleanup() {
  [ -n "$shell_pid" ] && kill "$shell_pid" 2>/dev/null
  systemctl --user --no-block stop amerika-session.target 2>/dev/null || true
}
trap 'cleanup' EXIT
trap 'exit 0' TERM INT HUP

# authentication prompts for pkexec (software installs, etc.)
for agent in /usr/lib/*/libexec/polkit-kde-authentication-agent-1; do
  [ -x "$agent" ] && { "$agent" >/dev/null 2>&1 & break; }
done

# Only services explicitly enabled by this user are pulled into this target.
# Stopping it at logout also stops the opt-in Agent gateway and its children.
systemctl --user --no-block start amerika-session.target 2>/dev/null || true

# the shell: restart it if it crashes, end the session if it exits cleanly (log out)
crashes=0
while [ "$crashes" -lt 5 ]; do
  started=$(date +%s)
  "${AMERIKA_BIN:-/usr/bin}/amerika-shell" &
  shell_pid=$!
  wait "$shell_pid"   # waiting (not running in the foreground) lets the signal traps fire at once
  code=$?
  shell_pid=
  [ "$code" -eq 0 ] && exit 0
  now=$(date +%s)
  if [ $((now - started)) -gt 60 ]; then crashes=0; else crashes=$((crashes + 1)); fi
  sleep 1
done
exit 1
