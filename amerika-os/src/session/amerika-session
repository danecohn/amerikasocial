#!/bin/sh
# Amerika OS session entry point. It runs the stock Plasma (KWin) Wayland session
# with the Amerika shell package selected, and leaves the Plasma session untouched.
export AMERIKA_SESSION=1
export XDG_SESSION_DESKTOP=Amerika
set -- /usr/lib/*/libexec/plasma-dbus-run-session-if-needed
exec "$1" /usr/bin/startplasma-wayland
